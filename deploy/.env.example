COMPOSE_PROJECT_NAME=

# Redis

REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

# Judge

JUDGE_ID=

# Токен ejudge api этого judge (тот же, что в judges.json у rmatics)
EJUDGE_API_TOKEN=

# Rmatics

